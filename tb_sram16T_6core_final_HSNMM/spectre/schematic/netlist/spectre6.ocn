simulator( 'spectre )
design(	 "/home/disk/simulation/SIM_IC61/tb_sram16T_6core_final_HSNMM/spectre/schematic/netlist/netlist")
resultsDir( "/home/disk/simulation/SIM_IC61/tb_sram16T_6core_final_HSNMM/spectre/schematic" )
modelFile( 
    '("/home/work/gpdk045_v_5_0/gpdk045/../models/spectre/gpdk045.scs" "ss")
)
analysis('dc ?dev "/VNOISE"  ?param "dc"  ?start "0"  
